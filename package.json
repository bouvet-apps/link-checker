{
  "name": "resources",
  "version": "2.0.0",
  "description": "Back-end resources",
  "license": "UNLICENSED",
  "author": "Bouvet",
  "scripts": {
    "build": "npm-run-all build:*",
    "build:js": "babel src/main/resources --out-dir=build/resources/main --ignore \"**/*.js\"",
    "build:frontend": "cd src/frontend && npm run build",
    "build:webpack": "webpack --config webpack.config.js",
    "watch": "npm-run-all --parallel watch:*",
    "watch:js": "npm run build:js -- --watch",
    "watch:widget": "webpack --config webpack.config.js --watch",
    "watch:frontend": "cd src/frontend && npm run watch",
    "watch:browserSync": "npx browser-sync start --files \"src/main/resources/**/*.html\" \"src/main/resources/**/*.xml\" \"build/resources/main\" --reload-delay 0 --port 3003 --no-snippet --watch",
    "lint": "eslint --fix --ext=js --ext=es6 ./src/main/resources"
  },
  "dependencies": {
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@babel/cli": "7.28.6",
    "@babel/core": "7.29.0",
    "@babel/plugin-transform-nullish-coalescing-operator": "7.28.6",
    "@babel/plugin-transform-optional-chaining": "7.28.6",
    "@babel/preset-env": "7.29.2",
    "@babel/eslint-parser": "7.28.6",
    "babel-loader": "9.2.1",
    "browser-sync": "^3.0.4",
    "concurrently": "9.2.1",
    "eslint": "8.57.1",
    "eslint-config-airbnb": "19.0.4",
    "eslint-plugin-import": "2.32.0",
    "npm-run-all": "4.1.5",
    "webpack": "5.106.2",
    "webpack-cli": "6.0.1"
  }
}
