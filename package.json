{
  "name": "resources",
  "version": "2.0.0",
  "description": "Back-end resources",
  "license": "UNLICENSED",
  "author": "Bouvet",
  "scripts": {
    "build": "npm-run-all build:*",
    "build:js": "babel src/main/resources --out-dir=build/resources/main --ignore \"**/*.js\"",
    "build:webpack": "webpack --config webpack.config.js",
    "watch": "npm-run-all --parallel watch:*",
    "watch:js": "npm run build:js -- --watch",
    "watch:widget": "webpack --config webpack.config.js --watch",
    "watch:frontend": "cd src/frontend && npm run watch",
    "watch:browserSync": "npx browser-sync start --files \"src/main/resources/**/*.html\" \"src/main/resources/**/*.xml\" \"build/resources/main\" --reload-delay 0 --port 3003 --no-snippet --watch"
  },
  "dependencies": {
    "xlsx": "file:vendor/xlsx-0.18.11.tgz"
  },
  "devDependencies": {
    "@babel/cli": "7.22.10",
    "@babel/core": "7.23.6",
    "@babel/eslint-parser": "7.23.3",
    "@babel/plugin-transform-nullish-coalescing-operator": "7.23.4",
    "@babel/plugin-transform-optional-chaining": "7.23.4",
    "@babel/preset-env": "7.22.14",
    "babel-loader": "9.1.3",
    "browser-sync": "^3.0.2",
    "concurrently": "8.2.1",
    "eslint": "8.48.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-plugin-import": "2.29.1",
    "npm-run-all": "4.1.5",
    "webpack": "5.89.0",
    "webpack-cli": "5.1.4"
  }
}
