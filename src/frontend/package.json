{
  "name": "website",
  "version": "1.0.0",
  "description": "Frontend for link-checker",
  "main": "./scripts/main.jsx",
  "scripts": {
    "clean": "rimraf ../../build/resources/main/assets",
    "lint": "eslint --config ../../.eslintrc.json scripts/**/*.es6",
    "build": "npm-run-all build:*",
    "build:js": "webpack --config webpack.config.js --node-env=production",
    "watch": "npm-run-all --parallel watch:*",
    "watch:js": "webpack --config webpack.config.js --node-env=development --watch",
    "watch:tailwind": "npx tailwindcss -i ./styles/main.css -o ../../build/resources/main/assets/css/tailwind.css --watch"
  },
  "author": "Bouvet",
  "license": "UNLICENSED",
  "dependencies": {
    "@babel/core": "^7.23.0",
    "@babel/plugin-transform-optional-chaining": "^7.27.1",
    "@babel/preset-env": "^7.22.20",
    "@babel/preset-react": "^7.22.15",
    "babel-loader": "^9.1.3",
    "classnames": "^2.5.1",
    "dompurify": "^3.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-intersection-observer": "^9.8.2",
    "react-modal": "^3.16.1",
    "react-multi-select-component": "^4.3.4"
  },
  "devDependencies": {
    "css-loader": "^7.1.0",
    "mini-css-extract-plugin": "^2.7.6",
    "style-loader": "^4.0.0",
    "tailwindcss": "^3.4.3",
    "webpack-dev-server": "^4.15.1"
  }
}
