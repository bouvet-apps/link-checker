{
  "name": "website",
  "version": "1.0.0",
  "description": "Frontend for link-checker",
  "main": "./scripts/main.jsx",
  "scripts": {
    "clean": "rimraf ../../build/resources/main/assets",
    "lint": "eslint --ext .js,.jsx scripts",
    "build": "npm-run-all -s build:tailwind build:js",
    "build:js": "webpack --config webpack.config.js --node-env=production",
    "build:tailwind": "npx tailwindcss -i ./styles/main.css -o ../../build/resources/main/assets/css/tailwind.css --minify",
    "watch": "npm-run-all --parallel watch:*",
    "watch:js": "webpack --config webpack.config.js --node-env=development --watch",
    "watch:tailwind": "npx tailwindcss -i ./styles/main.css -o ../../build/resources/main/assets/css/tailwind.css --watch"
  },
  "author": "Bouvet",
  "license": "UNLICENSED",
  "dependencies": {
    "classnames": "2.5.1",
    "dompurify": "3.4.18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-intersection-observer": "9.16.0",
    "react-modal": "3.16.3",
    "react-multi-select-component": "4.3.4"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-optional-chaining": "7.29.7",
    "@babel/preset-env": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "babel-loader": "9.2.1",
    "css-loader": "7.1.5",
    "style-loader": "4.0.0",
    "tailwindcss": "3.4.19",
    "webpack-dev-server": "4.15.2"
  }
}
