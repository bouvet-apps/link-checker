{
    "extends": [
        "airbnb"
    ],
    "parser": "@babel/eslint-parser",
    "parserOptions": {
        "requireConfigFile": false,
        "ecmaVersion": 2021,
        "sourceType": "module"
    },
    "env": {
        "node": true
    },
    "rules": {
        "import/extensions": [
            "error",
            "ignorePackages",
            {
                "": "never",
                "js": "never",
                "mjs": "never",
                "jsx": "never",
                "ts": "never",
                "tsx": "never",
                "es6": "never",
                "vue": "never"
            }
        ],
        "indent": [
            "error",
            2,
            {
                "SwitchCase": 1
            }
        ],
        "linebreak-style": [
            "error",
            "unix"
        ],
        "quotes": [
            "error",
            "double"
        ],
        "semi": [
            "error",
            "always"
        ],
        "comma-dangle": [
            "error",
            "never"
        ],
        "no-cond-assign": [
            "error",
            "always"
        ],
        "no-console": "error",
        "global-require": "off",
        "import/no-unresolved": 0,
        "import/no-absolute-path": 0,
        "no-underscore-dangle": "off",
        "object-shorthand": "error",
        "object-property-newline": [
            "error",
            {
                "allowAllPropertiesOnSameLine": false
            }
        ],
        "prefer-destructuring": "off",
        "radix": [
            "error",
            "as-needed"
        ],
        "no-plusplus": "off",
        "max-len": [
            "error"
        ],
        "func-names": "error",
        "react/react-in-jsx-scope": "off",
        "react/prop-types": "off",
        "react/function-component-definition": "off",
        "react/button-has-type": "off",
        "no-restricted-syntax": "off",
        "no-use-before-define": "off",
        "react/no-array-index-key": "off",
        "import/prefer-default-export": "off",
        "react/jsx-props-no-spreading": "off",
        "jsx-a11y/label-has-associated-control": "off"
    },
    "globals": {
        "require": true,
        "log": true,
        "exports": true,
        "resolve": true,
        "app": true,
        "fetch": true,
        "document": true,
        "window": true,
        "__": true,
        "XLSX": true
    },
    "overrides": [
        {
            "files": [
                "src/main/resources/**/*.es6"
            ],
            "rules": {
                "import/extensions": "off"
            }
        },
        {
            "files": [
                "*.html",
                "*.ftl",
                "*.xml"
            ],
            "rules": {
                "max-len": "off"
            }
        },
        {
            "files": [
                "*.jsx"
            ],
            "rules": {
                "no-param-reassign": "off",
                "guard-for-in": "off",
                "max-len": "off"
            }
        }
    ],
    "settings": {
        "import/resolver": {
            "node": {
                "extensions": [
                    ".js",
                    ".jsx",
                    ".es6",
                    ".ts",
                    ".tsx",
                    ".json",
                    ".vue"
                ]
            }
        }
    }
}
